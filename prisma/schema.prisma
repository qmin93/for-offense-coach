generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Workspace
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces       WorkspaceMember[]
  plays            Play[]
  playbooks        Playbook[]
  shareLinks       ShareLink[]
  activities       Activity[]
  commentsAuthored PlayComment[] @relation("CommentAuthor")
  commentsResolved PlayComment[] @relation("CommentResolver")
}

model Workspace {
  id        String        @id @default(cuid())
  name      String
  type      WorkspaceType @default(PERSONAL)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  members    WorkspaceMember[]
  invites    WorkspaceInvite[]
  plays      Play[]
  playbooks  Playbook[]
  activities Activity[]
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(EDITOR)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

// ============================================
// Play (단일 다이어그램)
// ============================================

model Play {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  tags          String[] @default([])
  schemaVersion String   @default("1.0")
  dslJson       Json     // Play DSL JSON 전체 저장
  version       Int      @default(1)

  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator       User          @relation(fields: [createdBy], references: [id])
  playbookPlays PlaybookPlay[]
  shareLinks    ShareLink[]
  comments      PlayComment[]
}

// ============================================
// Playbook (플레이 모음)
// ============================================

model Playbook {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  description    String?
  tags           String[] @default([])
  sections       Json     // sections JSON array
  exportSettings Json?    // PDF export 설정

  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator        User           @relation(fields: [createdBy], references: [id])
  plays          PlaybookPlay[]
  shareLinks     ShareLink[]
}

model PlaybookPlay {
  id          String @id @default(cuid())
  playbookId  String
  playId      String
  sectionId   String
  order       Int

  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  play     Play     @relation(fields: [playId], references: [id], onDelete: Cascade)

  @@unique([playbookId, playId])
}

// ============================================
// Concept (컨셉 템플릿 - Pass/Run)
// ============================================

model Concept {
  id           String      @id @default(cuid())
  conceptType  ConceptType
  name         String
  summary      String
  badges       String[]    @default([])
  requirements Json        // minEligibleReceivers, preferredStructures 등
  template     Json        // roles, buildPolicy
  passHints    Json?       // category, manBeater, zoneBeater, stress
  runHints     Json?       // bestVsFront, bestVs3T, boxTolerance 등
  installFocus Json?       // failurePoints array

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum ConceptType {
  PASS
  RUN
}

// ============================================
// Formation (프리셋 배치)
// ============================================

model Formation {
  id            String   @id @default(cuid())
  name          String
  personnelHint String[] @default([])
  structure     String?  // 2x2, 3x1, bunch 등
  strength      String?  // left, right, none
  defaults      Json     // players array, snapRules

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// TeamProfile (포메이션 추천 엔진용)
// ============================================

model TeamProfile {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  teamName           String
  rosterAvailability Json     // QB, RB, FB, WR, TE, OL count & starterQuality
  unitStrength       Json     // olRunBlock, olPassPro, rbVision 등
  stylePreferences   Json     // runPassBalance, tempo 등
  notes              String[] @default([])

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================
// ShareLink (공유 링크)
// ============================================

model ShareLink {
  id          String         @id @default(cuid())
  token       String         @unique @default(cuid())
  targetType  ShareTarget
  playId      String?
  playbookId  String?
  permission  SharePermission @default(VIEW_ONLY)
  expiresAt   DateTime?

  createdBy   String
  createdAt   DateTime       @default(now())

  creator     User           @relation(fields: [createdBy], references: [id])
  play        Play?          @relation(fields: [playId], references: [id], onDelete: Cascade)
  playbook    Playbook?      @relation(fields: [playbookId], references: [id], onDelete: Cascade)
}

enum ShareTarget {
  PLAY
  PLAYBOOK
}

enum SharePermission {
  VIEW_ONLY
  VIEW_DOWNLOAD
}

// ============================================
// Workspace Invite (초대 대기)
// ============================================

model WorkspaceInvite {
  id          String       @id @default(cuid())
  workspaceId String
  email       String       // 초대받은 이메일
  role        Role         @default(EDITOR)
  token       String       @unique @default(cuid())
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime     // 초대 만료일

  invitedBy   String       // 초대한 사용자 ID
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ============================================
// Activity Feed (워크스페이스 활동 로그)
// ============================================

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  actorId     String       // 활동 수행자
  action      ActivityType
  targetType  String?      // "play" | "playbook" | "member"
  targetId    String?      // 대상 리소스 ID
  targetName  String?      // 대상 이름 (삭제되어도 표시용)
  metadata    Json?        // 추가 정보 (old/new values 등)
  createdAt   DateTime     @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User         @relation(fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
}

enum ActivityType {
  // Play 관련
  PLAY_CREATED
  PLAY_UPDATED
  PLAY_DELETED
  PLAY_DUPLICATED

  // Playbook 관련
  PLAYBOOK_CREATED
  PLAYBOOK_UPDATED
  PLAYBOOK_DELETED
  PLAY_ADDED_TO_PLAYBOOK
  PLAY_REMOVED_FROM_PLAYBOOK

  // Member 관련
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_ROLE_CHANGED
  MEMBER_INVITED

  // Share 관련
  SHARE_LINK_CREATED
  PLAY_FORKED

  // Comment 관련
  COMMENT_ADDED
  COMMENT_RESOLVED
}

// ============================================
// Play Comments (코칭 메모/마크업)
// ============================================

model PlayComment {
  id          String        @id @default(cuid())
  playId      String
  authorId    String
  content     String        // 코멘트 내용

  // 좌표 기반 핀 (선택적)
  pinX        Float?        // Normalized x coordinate (0-1)
  pinY        Float?        // Normalized y coordinate (-1 to 1)

  // 상태
  status      CommentStatus @default(OPEN)
  resolvedBy  String?       // 해결한 사용자 ID
  resolvedAt  DateTime?

  // 메타데이터
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  play        Play          @relation(fields: [playId], references: [id], onDelete: Cascade)
  author      User          @relation("CommentAuthor", fields: [authorId], references: [id])
  resolver    User?         @relation("CommentResolver", fields: [resolvedBy], references: [id])

  @@index([playId, createdAt])
}

enum CommentStatus {
  OPEN
  RESOLVED
}
